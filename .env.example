# Sunucu tarafı Google Places anahtarı. Repoya gerçek anahtar yazmayın.
# Anahtar yokken Google Haritalar yönlendirmesi çalışır; Pinwego içi liste "bağlı değil" der.
# Google Cloud'da Places API (New) açın, anahtarı sunucuyla sınırlayın.
GOOGLE_MAPS_API_KEY=

# İsteğe bağlı Resend yedeği. Canlı gönderim Worker EMAIL bağlamıyla yapılır.
# Repoya gerçek anahtar yazmayın. Anahtar ve bağlam yokken doğrulama mektubu gitmez.
RESEND_API_KEY=
EMAIL_FROM=Pinwego <hesap@pinwego.com>

# Yönetici girişi. Repoya gerçek değer yazmayın. Dört değer de boşsa yönetici kapısı kapalıdır.
ADMIN_LOGIN=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_OTP_TO=

# Cloudflare Turnstile. Site anahtarı sayfada görünür, gizli anahtar yalnızca sunucuda kalır.
# İkisi de boşken kayıt, yeniden gönderim ve şifre sıfırlama bot kontrolü istemez.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp Business Platform (Meta Cloud API). İkisi de boşsa WhatsApp API gönderimi "bağlı değil" der;
# yalnız manuel wa.me bağlantısı çalışır. Canlıda Worker gizli değişkeni olarak tanımlayın, repoya yazmayın.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# SMS sağlayıcısı. Adaptör bağlanana kadar üçü dolu olsa da gönderim yapılmaz (lib/sms.ts).
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
